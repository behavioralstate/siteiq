# ============================================================
# SiteIQ — configurazione ambiente .env (copia questo file in .env e riempi).
# Il loader cerca il file in backend/.env — NON la root del repo.
# NON committare mai il .env vero: è nel .gitignore.
# ============================================================

# --- OpenRouter / endpoint LLM (apertura OpenAI-compatible) ---
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=inserisci_la_tua_api_key
LLM_MODEL=deepseek/deepseek-chat-v3.1

# --- Autenticazione admin (Bearer token) ---
# Formato: <utente>=<token>. Separa più utenti con virgola.
# ⚠️ Genera un token tuo (es. openssl rand -hex 24) e usalo al posto del segnaposto.
AUTH_CLIENTS=fabio=inserisci_il_tuo_token_admin

# --- Email (SMTP) per invio report + conferma lead ---
SMTP_HOST=posta.xtsystem.it
SMTP_PORT=587
SMTP_USER=fabio@pensareweb.it
SMTP_PASSWORD=inserisci_password
SMTP_FROM=fabio@pensareweb.it

# --- Destinatario fisso del report (ogni analisi gli viene inviata via email) ---
REPORT_NOTIFY_EMAIL=lorenzo@pensareweb.it

# --- Base URL pubblica (per i link di conferma email) ---
# In dev in tunnel: http://localhost:8000
PUBLIC_BASE_URL=http://localhost:8000

# --- Path (opzionali, default in backend/) ---
# USAGE_DB=./siteiq_usage.db
# REPORTS_DIR=../reports