# ============================================================
# SiteIQ — configurazione ambiente .env (copia questo file in .env e riempi).
# Il loader cerca il file in backend/.env — NON la root del repo.
# Le variabili già presenti nell'ambiente (systemd, shell) hanno la precedenza.
# NON committare mai il .env vero: è nel .gitignore.
# ============================================================

# --- OpenRouter / endpoint LLM (API compatibile OpenAI) ---
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=inserisci_la_tua_api_key
LLM_MODEL=deepseek/deepseek-chat-v3.1

# --- Autenticazione admin (Bearer token) ---
# Formato: <utente>=<token>. Più utenti separati da virgola (o punto e virgola).
# Genera un token tuo (es. openssl rand -hex 24) e usalo al posto del segnaposto.
AUTH_CLIENTS=admin=inserisci_il_tuo_token_admin

# --- Email (SMTP) per invio report + conferma lead ---
# Porta 587 = STARTTLS, 465 = TLS implicito. SMTP_FROM vuoto = SMTP_USER.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=siteiq@example.com
SMTP_PASSWORD=inserisci_password
SMTP_FROM=siteiq@example.com

# --- Destinatario fisso del report (ogni analisi con LLM reale gli viene inviata) ---
# Vuoto = nessun invio. Le analisi con lo stub non inviano mai email.
REPORT_NOTIFY_EMAIL=

# --- Base URL pubblica (per i link di conferma email) ---
PUBLIC_BASE_URL=http://localhost:8000

# --- Limiti (opzionali; valori di default) ---
# SITEIQ_MAX_CONCURRENT_JOBS=2       # Chromium/LLM in parallelo
# SITEIQ_MAX_QUEUED_JOBS=20          # oltre: 503 "riprova più tardi"
# SITEIQ_JOB_TTL_S=3600              # job conclusi tenuti in memoria
# SITEIQ_LEADS_PER_IP_PER_HOUR=5
# SITEIQ_LEADS_PER_EMAIL_PER_DAY=3
# SITEIQ_SCANS_PER_IP_PER_HOUR=5
# SITEIQ_BEST_COMMANDS_PER_IP_PER_HOUR=10   # analisi via superficie BEST (pubblica)
# SITEIQ_BEST_MAX_EVENTS=5000                # eventi BEST tenuti in memoria

# --- Solo sviluppo/test: consente di analizzare host privati (localhost, LAN) ---
# MAI in produzione: riaprirebbe l'SSRF verso la rete interna.
# SITEIQ_ALLOW_PRIVATE_TARGETS=1

# --- Path (opzionali, default nella root del repo) ---
# USAGE_DB=../siteiq_usage.db
# REPORTS_DIR=../reports
